{
  "name": "@present/desktop",
  "productName": "Present",
  "version": "0.3.8",
  "description": "Church presentation software for worship services",
  "private": true,
  "scripts": {
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "node scripts/tauri-build.mjs",
    "tauri:ffmpeg": "bash scripts/build-ffmpeg.sh && node scripts/stage-tauri-ffmpeg.mjs",
    "tauri:vite:dev": "vite",
    "tauri:vite:build": "vite build --mode production",
    "tauri:stage-ndi": "node scripts/stage-tauri-ndi.mjs",
    "tauri:before-build": "node scripts/stage-tauri-ndi.mjs && bun run tauri:vite:build",
    "tauri:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml",
    "icons": "node scripts/generate-icons.cjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "quality": "bun run test && bun run typecheck && bun run lint",
    "lint": "eslint --ext .ts,.tsx .",
    "convex": "bun run --filter @present/backend convex"
  },
  "keywords": [],
  "author": {
    "name": "Cole",
    "email": "aderibigbeadedamolajohn@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.27",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "font-list": "^2.0.2",
    "grandi": "^1.3.0",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "@present/backend": "workspace:*",
    "@present/shared": "workspace:*",
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-context-menu": "^2.2.6",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/postcss": "^4.2.1",
    "@tanstack/query-sync-storage-persister": "^5.90.27",
    "@tanstack/react-query": "^5.91.0",
    "@tanstack/react-query-persist-client": "^5.90.27",
    "@tauri-apps/api": "^2.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.33.1",
    "dexie": "^4.3.0",
    "dexie-react-hooks": "^4.2.0",
    "fflate": "^0.8.2",
    "lucide-react": "^0.577.0",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^5.6.205",
    "postcss": "^8.5.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "^5.6.0",
    "react-resizable-panels": "^4.7.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "use-debounce": "^10.1.0"
  }
}
