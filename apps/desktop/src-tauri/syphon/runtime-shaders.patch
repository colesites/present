diff --git a/SyphonServerRendererMetal.m b/SyphonServerRendererMetal.m
index a6a6c36..c7d30ad 100644
--- a/SyphonServerRendererMetal.m
+++ b/SyphonServerRendererMetal.m
@@ -31,6 +31,36 @@
 #include <simd/simd.h>
 #include "SyphonServerMetalTypes.h"
 
+// Present: the shaders of SyphonMetalShaders.metal, compiled when the server
+// starts when the framework carries no default.metallib (it is built without
+// Xcode's separate Metal Toolchain).
+static NSString *const SyphonRuntimeShaderSource = @
+"#include <metal_stdlib>\n"
+"#include <simd/simd.h>\n"
+"using namespace metal;\n"
+"typedef struct { vector_float2 position; vector_float2 textureCoordinate; } SYPHONTextureVertex;\n"
+"typedef struct { float4 clipSpacePosition [[position]]; float2 textureCoordinate; } RasterizerData;\n"
+"vertex RasterizerData textureToScreenVertexShader(uint vertexID [[ vertex_id ]],\n"
+"    constant SYPHONTextureVertex *vertexArray [[ buffer(0) ]],\n"
+"    constant vector_uint2 *viewportSizePointer [[ buffer(1) ]])\n"
+"{\n"
+"    RasterizerData out;\n"
+"    float2 pixelSpacePosition = vertexArray[vertexID].position.xy;\n"
+"    float2 viewportSize = float2(*viewportSizePointer);\n"
+"    out.clipSpacePosition.xy = pixelSpacePosition / (viewportSize / 2.0);\n"
+"    out.clipSpacePosition.z = 0.0;\n"
+"    out.clipSpacePosition.w = 1.0;\n"
+"    out.textureCoordinate = vertexArray[vertexID].textureCoordinate;\n"
+"    return out;\n"
+"}\n"
+"fragment float4 textureToScreenSamplingShader(RasterizerData in [[stage_in]],\n"
+"    texture2d<half> colorTexture [[ texture(0) ]])\n"
+"{\n"
+"    constexpr sampler textureSampler (mag_filter::nearest, min_filter::nearest);\n"
+"    const half4 colorSample = colorTexture.sample(textureSampler, in.textureCoordinate);\n"
+"    return float4(colorSample);\n"
+"}\n";
+
 @implementation SyphonServerRendererMetal
 {
     id<MTLRenderPipelineState> _pipelineState;
@@ -44,7 +74,12 @@
         NSError *error = NULL;
         NSBundle *bundle = [NSBundle bundleForClass:[self class]];
         id<MTLLibrary> defaultLibrary = [device newDefaultLibraryWithBundle:bundle error:&error];
-        if(error)
+        if(!defaultLibrary)
+        {
+            error = NULL;
+            defaultLibrary = [device newLibraryWithSource:SyphonRuntimeShaderSource options:nil error:&error];
+        }
+        if(!defaultLibrary)
         {
             SYPHONLOG(@"Metal library could not be loaded:%@", error);
         }
